          <section class="product-info">
            <h3>Curso de Web Design</h3>
            <p class="price">R$ 189,90</p>
            <button data-link="/paginnerprod" class="btn-view">Ver Detalhes</button>
          </section>
        </section>

        <!-- Produto 3 -->
        <section class="product-card">
          <img src="image/frontend.png" alt="Produto">
          <section class="product-info">
            <h3>Ebook: Domine o Front End</h3>
