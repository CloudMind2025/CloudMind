<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Minhas Compras</title>
   <link rel="stylesheet" href="/css/menu.css">
  <link rel="stylesheet" href="/css/sidebar.css">
   <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/minhascompras.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
   <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <header>
  
   <%- include('../partials/menu') %>

  </header>
  <section class="layout">
    
        <%- include('../partials/sidebar') %>

    <!-- Conteúdo -->
    <main class="main">
       <%- include('../partials/btnV') %>
      <header class="page-header">
        <h1>Minhas Compras</h1>
        <p>Acompanhe seus pedidos, status e detalhes de cada compra.</p>
      </header>

      <section class="compras-lista">
        
        <!-- Pedido -->
        <article class="card-compra">
          <img src="/image/soluçãoweb.png" alt="Produto">
          <section class="detalhes">
            <h2>Curso Solução Web</h2>
            <p><strong>Data:</strong> 02/10/2025</p>
            <p><strong>Valor:</strong> R$ 149,90</p>
            <p><strong>Status:</strong> <span class="status enviado">Enviado</span></p>
          </section>
          <section class="acoes">
            <button data-link="/detalhepedido" class="btn">Ver Detalhes</button>
            <button class="btn secundario">Nota Fiscal</button>
          </section>
        </article>

        <article class="card-compra">
          <img src="/image/frontend.png" alt="Produto">
          <section class="detalhes">
            <h2>Ebook: Domine o FrontEnd</h2>
            <p><strong>Data:</strong> 20/09/2025</p>
            <p><strong>Valor:</strong> R$ 89,90</p>
            <p><strong>Status:</strong> <span class="status concluido">Concluído</span></p>
          </section>
          <section class="acoes">
            <button data-link="/detalhepedido" class="btn">Ver Detalhes</button>
            <button class="btn secundario">Avaliar</button>
          </section>
        </article>

        <article class="card-compra">
          <img src="/image/programacao.png" alt="Produto">
          <section class="detalhes">
            <h2>Curso Programação</h2>
            <p><strong>Data:</strong> 10/09/2025</p>
            <p><strong>Valor:</strong> R$ 229,90</p>
            <p><strong>Status:</strong> <span class="status pendente">Pendente</span></p>
          </section>
          <section class="acoes">
            <button data-link="/detalhepedido" class="btn">Ver Detalhes</button>
            <button class="btn secundario">Cancelar</button>
          </section>
        </article>









      <article class="card-compra">
          <img src="/image/soluçãoweb.png" alt="Produto">
          <section class="detalhes">
            <h2>Curso Solução Web</h2>
            <p><strong>Data:</strong> 02/10/2025</p>
            <p><strong>Valor:</strong> R$ 149,90</p>
            <p><strong>Status:</strong> <span class="status enviado">Enviado</span></p>
          </section>
          <section class="acoes">
            <button data-link="/detalhepedido" class="btn">Ver Detalhes</button>
            <button class="btn secundario">Nota Fiscal</button>
          </section>
        </article>

        <article class="card-compra">
          <img src="/image/frontend.png" alt="Produto">
          <section class="detalhes">
            <h2>Ebook: Domine o FrontEnd</h2>
            <p><strong>Data:</strong> 20/09/2025</p>
            <p><strong>Valor:</strong> R$ 89,90</p>
            <p><strong>Status:</strong> <span class="status concluido">Concluído</span></p>
          </section>
          <section class="acoes">
            <button data-link="/detalhepedido" class="btn">Ver Detalhes</button>
            <button class="btn secundario">Avaliar</button>
          </section>
        </article>

        <article class="card-compra">
          <img src="/image/programacao.png" alt="Produto">
          <section class="detalhes">
            <h2>Curso Programação</h2>
            <p><strong>Data:</strong> 10/09/2025</p>
            <p><strong>Valor:</strong> R$ 229,90</p>
            <p><strong>Status:</strong> <span class="status pendente">Pendente</span></p>
          </section>
          <section class="acoes">
            <button data-link="/detalhepedido" class="btn">Ver Detalhes</button>
            <button class="btn secundario">Cancelar</button>
          </section>
        </article>

      </section>
    </main>
  </section>

  <footer>

        <%- include('../partials/footer') %>

  </footer>

  <script src="/js/linker.js"></script>
  
</body>
</html>
